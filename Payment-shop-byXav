<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🛒 Xav|Dynasty — Shop & Payment</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f0f23, #1a1a3c, #2d1b69);
            min-height: 100vh;
            padding: 30px 20px;
            color: white;
            position: relative;
            overflow-x: hidden;
        }

        .container {
            max-width: 460px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        /* === NAVIGASI TAB === */
        .tabs {
            display: flex;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 5px;
            margin-bottom: 25px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tab-btn {
            flex: 1;
            padding: 12px 10px;
            border-radius: 12px;
            border: none;
            background: transparent;
            color: #aaa;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tab-btn.active {
            background: linear-gradient(90deg, #00d4ff, #7928ca);
            color: white;
            box-shadow: 0 4px 12px rgba(0, 200, 255, 0.3);
        }

        /* === HEADER === */
        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .header h1 {
            font-size: 28px;
            background: linear-gradient(90deg, #00d4ff, #7928ca, #ff0080);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 8px;
            filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.3));
        }

        .header p {
            color: #ccc;
            font-size: 15px;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(121, 40, 202, 0.2);
            padding: 8px 18px;
            border-radius: 30px;
            margin-top: 12px;
            font-size: 14px;
            color: #d8b4fe;
            border: 1px solid rgba(121, 40, 202, 0.3);
        }

        /* === KARD UMUM === */
        .card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(24px);
            border-radius: 24px;
            padding: 25px 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 40px rgba(121, 40, 202, 0.15);
            margin-bottom: 25px;
        }

        /* === HALAMAN TOKO — PRODUK === */
        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .product-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .product-card:hover {
            border-color: rgba(0, 212, 255, 0.4);
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(121, 40, 202, 0.2);
        }

        .product-icon {
            font-size: 36px;
            margin-bottom: 10px;
        }

        .product-name {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .product-price {
            font-size: 16px;
            font-weight: 700;
            color: #00d4ff;
            margin-bottom: 10px;
        }

        .buy-btn {
            width: 100%;
            background: linear-gradient(90deg, #00d4ff, #7928ca);
            color: white;
            border: none;
            padding: 8px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .buy-btn:hover {
            transform: scale(1.03);
        }

        /* === 🎥 VIDEO DI ATAS QRIS === */
        .top-video-box {
            margin-bottom: 25px;
            text-align: center;
        }

        .top-video {
            width: 100%;
            max-width: 380px;
            height: 220px;
            border-radius: 16px;
            object-fit: cover;
            box-shadow: 0 4px 20px rgba(0, 200, 255, 0.25);
            border: 2px solid rgba(0, 212, 255, 0.35);
        }

        /* === QRIS === */
        .qris-section {
            text-align: center;
            margin-bottom: 25px;
        }

        .qris-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(90deg, #0066ff, #00ccff);
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: bold;
            font-size: 15px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0, 102, 255, 0.3);
        }

        .qris-box {
            background: #ffffff;
            border-radius: 16px;
            padding: 15px;
            display: inline-block;
            box-shadow: 0 4px 20px rgba(0, 200, 255, 0.25);
            border: 2px solid #e0e0e0;
            margin-bottom: 12px;
        }

        .qris-img {
            width: 220px;
            height: 220px;
            border-radius: 8px;
            object-fit: contain;
            display: block;
        }

        .download-qris-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(90deg, #00d4ff, #7928ca);
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            margin-top: 15px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 200, 255, 0.3);
        }

        .download-qris-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(121, 40, 202, 0.4);
        }

        .scan-text {
            font-size: 13px;
            color: #aaa;
            margin-top: 12px;
        }

        /* === PEMISAH === */
        .divider {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 25px 0;
        }

        .divider hr {
            flex: 1;
            border: none;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        }

        .divider span {
            color: #777;
            font-size: 13px;
        }

        /* === METODE PEMBAYARAN === */
        .method-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #ddd;
        }

        .method-box {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 12px;
            transition: all 0.3s ease;
        }

        .method-box:hover {
            border-color: rgba(0, 200, 255, 0.4);
            background: rgba(0, 200, 255, 0.05);
            transform: translateY(-2px);
        }

        .method-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .method-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0099ff, #00d4ff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .method-name {
            font-weight: 600;
            font-size: 16px;
        }

        .method-badge {
            margin-left: auto;
            background: linear-gradient(90deg, #00d4ff, #7928ca);
            color: white;
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 10px;
            font-weight: bold;
        }

        .method-number {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 4px;
            color: #fff;
        }

        .method-holder {
            font-size: 13px;
            color: #999;
            margin-bottom: 12px;
        }

        .copy-btn {
            background: rgba(0, 212, 255, 0.1);
            color: #00d4ff;
            border: 1px solid rgba(0, 212, 255, 0.3);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .copy-btn:hover {
            background: #00d4ff;
            color: #000;
        }

        .copy-btn.copied {
            background: #00ff88;
            color: #000;
            border-color: #00ff88;
        }

        /* === CATATAN === */
        .note-box {
            background: rgba(255, 170, 0, 0.08);
            border: 1px solid rgba(255, 170, 0, 0.2);
            border-radius: 12px;
            padding: 15px;
            margin-top: 20px;
        }

        .note-box h4 {
            color: #ffcc00;
            font-size: 14px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .note-box p {
            font-size: 13px;
            color: #bbb;
            line-height: 1.6;
        }

        /* === FOOTER === */
        .footer {
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
            color: #555;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- HEADER BRAND -->
    <div class="header">
        <h1>🛒 Xav|Dynasty</h1>
        <p>Official Store — Kualitas Terbaik & Terpercaya</p>
        <div class="brand-badge">✨ By Xav|Dynasty</div>
    </div>

    <!-- TAB NAVIGASI -->
    <div class="tabs">
        <button class="tab-btn active" onclick="bukaTab('shop')">🛍️ Toko</button>
        <button class="tab-btn" onclick="bukaTab('payment')">💳 Bayar</button>
    </div>

    <!-- ================================== -->
    <!-- HALAMAN 1: TOKO / PRODUK -->
    <!-- ================================== -->
    <div class="page active" id="page-shop">
        <div class="card">
            <h2 class="section-title">🔥 Produk Kami</h2>
            <div class="product-grid">
                <!-- PRODUK 1 -->
                <div class="product-card">
                    <div class="product-icon">🎮</div>
                    <div class="product-name">Top Up Game</div>
                    <div class="product-price">Rp 5.000</div>
                    <button class="buy-btn" onclick="bukaTab('payment')">Beli Sekarang</button>
                </div>
                <!-- PRODUK 2 -->
                <div class="product-card">
                    <div class="product-icon">📱</div>
                    <div class="product-name">E-Wallet</div>
                    <div class="product-price">Rp 10.000</div>
                    <button class="buy-btn" onclick="bukaTab('payment')">Beli Sekarang</button>
                </div>
                <!-- PRODUK 3 -->
                <div class="product-card">
                    <div class="product-icon">🌐</div>
                    <div class="product-name">Voucher</div>
                    <div class="product-price">Rp 15.000</div>
                    <button class="buy-btn" onclick="bukaTab('payment')">Beli Sekarang</button>
                </div>
                <!-- PRODUK 4 -->
                <div class="product-card">
                    <div class="product-icon">⚡</div>
                    <div class="product-name">Layanan VIP</div>
                    <div class="product-price">Rp 25.000</div>
                    <button class="buy-btn" onclick="bukaTab('payment')">Beli Sekarang</button>
                </div>
            </div>
        </div>

        <!-- INFO TOKO -->
        <div class="card">
            <h2 class="section-title">ℹ️ Info Toko</h2>
            <p style="font-size:14px; color:#ccc; line-height:1.8;">
                ✅ Open 24 Jam<br>
                ✅ Proses Cepat & Aman<br>
                ✅ Garansi Uang Kembali<br>
                ✅ Resmi By Xav|Dynasty
            </p>
        </div>
    </div>

    <!-- ================================== -->
    <!-- HALAMAN 2: PEMBAYARAN + VIDEO! -->
    <!-- ================================== -->
    <div class="page" id="page-payment">
        <div class="card">
            <h2 class="section-title" style="justify-content:center; font-size:22px;">💳 Pembayaran</h2>
            <p style="text-align:center; color:#aaa; margin-bottom:20px;">Silakan bayar melalui metode di bawah</p>

            <!-- 🎥 VIDEO DI ATAS QRIS — SUDAH KEMBALI! -->
            <div class="top-video-box">
                <video class="top-video" id="topVideo" loop playsinline controls>
                    <source src="https://cdn.videy.co/ZLxBOhDP1.mp4" type="video/mp4">
                    Browser kamu tidak mendukung video.
                </video>
            </div>

            <!-- QRIS -->
            <div class="qris-section">
                <div class="qris-label">📱 QRIS — Semua Pembayaran</div>
                <div class="qris-box">
                    <img src="https://i.ibb.co/g1mZnq5/img-1788362928574.jpg" class="qris-img" alt="QRIS" loading="lazy">
                </div>
                <a href="https://i.ibb.co/g1mZnq5/img-1788362928574.jpg" download="QRIS-Xav-Dynasty.jpg" class="download-qris-btn">
                    ⬇️ Download QRIS
                </a>
                <p class="scan-text">Scan kode QR atau download untuk dipindai</p>
            </div>

            <div class="divider">
                <hr>
                <span>Atau</span>
                <hr>
            </div>

            <!-- DANA -->
            <h3 class="method-title">💸 Transfer E-Wallet</h3>
            <div class="method-box">
                <div class="method-header">
                    <div class="method-icon">💙</div>
                    <div class="method-name">DANA</div>
                    <div class="method-badge">Utama</div>
                </div>
                <div class="method-number" id="nomorDana">0815-4550-1924</div>
                <div class="method-holder">a.n. Xav|Dynasty</div>
                <button class="copy-btn" onclick="salinNomor('nomorDana', this)">📋 Salin Nomor</button>
            </div>

            <!-- CATATAN -->
            <div class="note-box">
                <h4>⚠️ Catatan Penting</h4>
                <p>1. Pastikan nomor tujuan dan nama sudah benar.<br>
                   2. Setelah bayar, simpan bukti pembayaran.<br>
                   3. Konfirmasi ke admin agar segera diproses.</p>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
        © 2026 Xav|Dynasty — All Rights Reserved
    </div>
</div>

<script>
    // === FUNGSI PINDAH HALAMAN ===
    function bukaTab(namaTab) {
        // Ubah tombol aktif
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');

        // Tampilkan halaman yang dipilih
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById('page-' + namaTab).classList.add('active');

        // Scroll ke atas
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // === FUNGSI SALIN NOMOR DANA ===
    function salinNomor(id, btn) {
        const nomor = document.getElementById(id).innerText;
        navigator.clipboard.writeText(nomor).then(() => {
            btn.classList.add('copied');
            btn.innerText = '✅ Tersalin!';
            setTimeout(() => {
                btn.classList.remove('copied');
                btn.innerText = '📋 Salin Nomor';
            }, 2500);
        }).catch(err => {
            alert('Gagal menyalin: ' + nomor);
        });
    }
</script>

</body>
</html>
